# Copy to .env.local for local development, and paste the same two values into
# Vercel → Settings → Environment Variables when you deploy.
# Both come from your Supabase project: Settings → API.
# Neither is a secret: they are sent to the browser, and the database is protected
# by row-level security, not by hiding these.

NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
